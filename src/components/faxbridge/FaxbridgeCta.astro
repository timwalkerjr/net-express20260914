---
// FaxBridge Final CTA Section
---

<section id="cta" class="relative isolate py-[92px] bg-[#0c2136]/50 border-t border-white/[0.06]">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[48px] items-center">

      <!-- Left Column -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-4 h-[2px] bg-[#94e760]"></span>
          <span class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase">
            Ready to modernize
          </span>
        </div>
        <h2 class="text-[36px] font-extrabold text-[#eef3f7] leading-[1.08] tracking-[-1.1px] mb-4">
          Ready to modernize your faxing?
        </h2>
        <p class="text-[#9fb1c2] text-[17.28px] leading-[28.51px] mb-8 max-w-[560px]">
          Talk to a Michigan-based specialist and we'll get FaxBridge set up for your business.
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href="tel:+18553132300"
            class="bg-white text-[#0a1a2e] font-semibold text-[16px] px-[28px] py-[15px] rounded-[10px] hover:bg-[#eef3f7] transition-all no-underline"
          >
            Call (855) 313-2300
          </a>
          <a
            href="/#contact"
            class="border border-white/20 text-[#e6ecf2] font-semibold text-[16px] px-[28px] py-[15px] rounded-[10px] hover:border-[#94e760] hover:text-white transition-all no-underline"
          >
            Request a Quote
          </a>
        </div>
      </div>

      <!-- Right Column: Contact Card -->
      <div class="lg:col-span-5">
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[18px] p-[28px] space-y-4">
          <div class="flex items-center gap-4">
            <div class="bg-[#94e760]/12 text-[#94e760] p-3 rounded-[10px] shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <span class="text-[#9fb1c2] text-[11.5px] uppercase tracking-wider font-semibold block">CALL US</span>
              <a href="tel:+18553132300" class="text-white font-semibold text-[16.8px] hover:text-[#94e760] transition-colors no-underline">
                (855) 313-2300
              </a>
            </div>
          </div>

          <div class="w-full h-[1px] bg-white/[0.09]"></div>

          <div class="flex items-center gap-4">
            <div class="bg-[#94e760]/12 text-[#94e760] p-3 rounded-[10px] shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="text-[#9fb1c2] text-[11.5px] uppercase tracking-wider font-semibold block">EMAIL</span>
              <a href="mailto:support@gonetexpress.com" class="text-white font-semibold text-[16.8px] hover:text-[#94e760] transition-colors no-underline">
                support@gonetexpress.com
              </a>
            </div>
          </div>

          <div class="w-full h-[1px] bg-white/[0.09]"></div>

          <div class="flex items-center gap-4">
            <div class="bg-[#94e760]/12 text-[#94e760] p-3 rounded-[10px] shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <span class="text-[#9fb1c2] text-[11.5px] uppercase tracking-wider font-semibold block">VISIT</span>
              <span class="text-white font-semibold text-[16px]">6825 Dixie Hwy, Clarkston, MI 48346</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
