---
// FaxBridge Hero Section
---

<section id="top" class="relative isolate pt-[64px] pb-[48px] overflow-hidden">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[48px] items-center">

      <!-- Left Column: Copy & CTA -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Eyebrow -->
        <div class="flex items-center gap-2 mb-4">
          <span class="w-4 h-[2px] bg-[#94e760]"></span>
          <span class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase">
            Virtual Fax · FaxBridge
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-[50px] sm:text-[62.4px] font-extrabold text-[#eef3f7] leading-[1.02] tracking-[-2.18px] mb-6">
          Internet-enable your fax machine.
        </h1>

        <!-- Subhead -->
        <p class="text-[#9fb1c2] text-[18.56px] leading-[29.7px] font-normal mb-8 max-w-[560px]">
          FaxBridge is a small device that connects your existing fax machine to the internet — send and receive faxes without an expensive analog phone line, with every fax stored securely in the cloud.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4">
          <a
            href="/#contact"
            class="bg-white text-[#0a1a2e] font-semibold text-[16px] px-[28px] py-[15px] rounded-[10px] hover:bg-[#eef3f7] hover:shadow-lg transition-all no-underline inline-flex items-center gap-1.5"
          >
            Get Started
          </a>
          <a
            href="#pricing"
            class="border border-white/20 text-[#e6ecf2] font-semibold text-[16px] px-[28px] py-[15px] rounded-[10px] hover:border-[#94e760] hover:text-white transition-all no-underline"
          >
            See Pricing
          </a>
        </div>
      </div>

      <!-- Right Column: Featured Visual Card -->
      <div class="lg:col-span-5">
        <div class="bg-[#0c2136]/90 backdrop-blur-md border border-[#94e760]/25 rounded-[20px] p-[32px] shadow-2xl">
          <div class="text-center mb-6">
            <div class="bg-[#94e760]/12 text-[#94e760] w-16 h-16 rounded-[14px] flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h2 class="text-white font-bold text-[20px] mb-1">FaxBridge Device</h2>
            <p class="text-[#9fb1c2] text-[13.6px]">Plug-and-play · No new hardware</p>
          </div>

          <div class="space-y-3">
            <div class="bg-white/[0.035] border border-white/[0.09] rounded-[12px] p-[14px_16px] flex items-center gap-3">
              <div class="bg-[#94e760]/15 text-[#94e760] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-white font-medium text-[15px]">Connect your fax machine</span>
            </div>
            <div class="bg-white/[0.035] border border-white/[0.09] rounded-[12px] p-[14px_16px] flex items-center gap-3">
              <div class="bg-[#94e760]/15 text-[#94e760] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-white font-medium text-[15px]">Send & receive over internet</span>
            </div>
            <div class="bg-white/[0.035] border border-white/[0.09] rounded-[12px] p-[14px_16px] flex items-center gap-3">
              <div class="bg-[#94e760]/15 text-[#94e760] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-white font-medium text-[15px]">Cloud storage included</span>
            </div>
            <div class="bg-white/[0.035] border border-white/[0.09] rounded-[12px] p-[14px_16px] flex items-center gap-3">
              <div class="bg-[#94e760]/15 text-[#94e760] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-white font-medium text-[15px]">Drop the analog line</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
