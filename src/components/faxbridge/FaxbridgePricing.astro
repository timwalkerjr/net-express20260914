---
// FaxBridge Pricing Section
---

<section id="pricing" class="relative isolate py-[92px]">
  <div class="max-w-[1180px] mx-auto px-6">

    <!-- Section Header -->
    <div class="max-w-[720px] text-left mb-[48px]">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-4 h-[2px] bg-[#94e760]"></span>
        <span class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase">
          Pricing
        </span>
      </div>
      <h2 class="text-[36px] font-extrabold text-[#eef3f7] leading-[1.08] tracking-[-1.1px] mb-4">
        Simple, transparent pricing.
      </h2>
      <p class="text-[#9fb1c2] text-[17.28px] leading-[28.51px]">
        A one-time device, then a low monthly rate per line. A Net Express subscription is required.
      </p>
    </div>

    <!-- Pricing Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-[24px] max-w-[820px]">

      <!-- Device Card -->
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[36px] hover:border-[#94e760]/40 transition-all">
        <h3 class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase mb-3">Device</h3>
        <div class="flex items-baseline gap-1 mb-2">
          <span class="text-[#eef3f7] font-extrabold text-[48px] leading-none">$99</span>
        </div>
        <p class="text-[#9fb1c2] text-[14.4px] mb-6">one-time, plus shipping & handling</p>

        <div class="w-full h-[1px] bg-white/[0.09] mb-6"></div>

        <ul class="space-y-3">
          <li class="flex items-start gap-3 text-[#eef3f7] text-[15.36px]">
            <svg class="w-5 h-5 text-[#94e760] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Works with your existing fax machine
          </li>
          <li class="flex items-start gap-3 text-[#eef3f7] text-[15.36px]">
            <svg class="w-5 h-5 text-[#94e760] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Plug-and-play setup
          </li>
          <li class="flex items-start gap-3 text-[#eef3f7] text-[15.36px]">
            <svg class="w-5 h-5 text-[#94e760] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Yours to keep
          </li>
        </ul>
      </div>

      <!-- Service Card -->
      <div class="bg-white/[0.035] border border-[#94e760]/40 rounded-[16px] p-[36px] relative transition-all">
        <div class="flex items-center gap-2 mb-3">
          <h3 class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase">Service</h3>
          <span class="bg-[#94e760]/20 text-[#94e760] text-[11px] font-semibold px-2 py-0.5 rounded-full uppercase tracking-wider">Monthly</span>
        </div>
        <div class="flex items-baseline gap-1 mb-2">
          <span class="text-[#eef3f7] font-extrabold text-[48px] leading-none">$15</span>
          <span class="text-[#9fb1c2] text-[16px] font-medium">/mo</span>
        </div>
        <p class="text-[#9fb1c2] text-[14.4px] mb-6">per active device (monthly)</p>

        <div class="w-full h-[1px] bg-white/[0.09] mb-6"></div>

        <ul class="space-y-3">
          <li class="flex items-start gap-3 text-[#eef3f7] text-[15.36px]">
            <svg class="w-5 h-5 text-[#94e760] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            300 outbound fax pages per month
          </li>
          <li class="flex items-start gap-3 text-[#eef3f7] text-[15.36px]">
            <svg class="w-5 h-5 text-[#94e760] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Secure cloud storage of every fax
          </li>
          <li class="flex items-start gap-3 text-[#eef3f7] text-[15.36px]">
            <svg class="w-5 h-5 text-[#94e760] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Requires a Net Express subscription
          </li>
        </ul>
      </div>

    </div>

    <!-- Disclaimer -->
    <p class="text-[#9fb1c2] text-[13.6px] mt-8 italic">
      Pricing reflects the current FaxBridge program and is subject to change — contact us for a quote.
    </p>
  </div>
</section>
