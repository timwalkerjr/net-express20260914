---
// FaxBridge Features / Why Section
---

<section id="features" class="relative isolate py-[92px]">
  <div class="max-w-[1180px] mx-auto px-6">

    <!-- Section Header -->
    <div class="max-w-[720px] text-left">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-4 h-[2px] bg-[#94e760]"></span>
        <span class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase">
          Why FaxBridge
        </span>
      </div>
      <h2 class="text-[36px] font-extrabold text-[#eef3f7] leading-[1.08] tracking-[-1.1px] mb-4">
        Modern faxing, no new hardware.
      </h2>
      <p class="text-[#9fb1c2] text-[17.28px] leading-[28.51px]">
        Keep the fax machine or multifunction printer you already have — FaxBridge does the rest.
      </p>
    </div>

    <!-- 6 Feature Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px] mt-[48px]">

      <!-- Card 1: Plug & play -->
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[32px] hover:border-[#94e760]/40 hover:-translate-y-1 hover:shadow-[0_14px_40px_rgba(0,0,0,0.3)] transition-all flex flex-col justify-between">
        <div>
          <div class="bg-[#94e760]/12 text-[#94e760] w-12 h-12 rounded-[11px] flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-[18.24px] font-bold text-[#eef3f7] mb-2.5">Plug & play</h3>
          <p class="text-[#9fb1c2] text-[15.36px] leading-[25px]">
            No complex setup or installation. Plug FaxBridge into your fax machine and your internet, and start faxing.
          </p>
        </div>
      </div>

      <!-- Card 2: No dedicated fax line -->
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[32px] hover:border-[#94e760]/40 hover:-translate-y-1 hover:shadow-[0_14px_40px_rgba(0,0,0,0.3)] transition-all flex flex-col justify-between">
        <div>
          <div class="bg-[#94e760]/12 text-[#94e760] w-12 h-12 rounded-[11px] flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
          </div>
          <h3 class="text-[18.24px] font-bold text-[#eef3f7] mb-2.5">No dedicated fax line</h3>
          <p class="text-[#9fb1c2] text-[15.36px] leading-[25px]">
            Faxes travel over your internet connection, so you can drop the costly analog phone line you've been paying for.
          </p>
        </div>
      </div>

      <!-- Card 3: Secure cloud storage -->
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[32px] hover:border-[#94e760]/40 hover:-translate-y-1 hover:shadow-[0_14px_40px_rgba(0,0,0,0.3)] transition-all flex flex-col justify-between">
        <div>
          <div class="bg-[#94e760]/12 text-[#94e760] w-12 h-12 rounded-[11px] flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
            </svg>
          </div>
          <h3 class="text-[18.24px] font-bold text-[#eef3f7] mb-2.5">Secure cloud storage</h3>
          <p class="text-[#9fb1c2] text-[15.36px] leading-[25px]">
            Every fax sent and received is automatically stored securely in the cloud — searchable, backed up, and compliant.
          </p>
        </div>
      </div>

      <!-- Card 4: Paperless by default -->
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[32px] hover:border-[#94e760]/40 hover:-translate-y-1 hover:shadow-[0_14px_40px_rgba(0,0,0,0.3)] transition-all flex flex-col justify-between">
        <div>
          <div class="bg-[#94e760]/12 text-[#94e760] w-12 h-12 rounded-[11px] flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-[18.24px] font-bold text-[#eef3f7] mb-2.5">Paperless by default</h3>
          <p class="text-[#9fb1c2] text-[15.36px] leading-[25px]">
            Incoming faxes arrive by email, so nothing prints unless you want it to — less paper, less waste.
          </p>
        </div>
      </div>

      <!-- Card 5: Minimal requirements -->
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[32px] hover:border-[#94e760]/40 hover:-translate-y-1 hover:shadow-[0_14px_40px_rgba(0,0,0,0.3)] transition-all flex flex-col justify-between">
        <div>
          <div class="bg-[#94e760]/12 text-[#94e760] w-12 h-12 rounded-[11px] flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-[18.24px] font-bold text-[#eef3f7] mb-2.5">Minimal requirements</h3>
          <p class="text-[#9fb1c2] text-[15.36px] leading-[25px]">
            All it needs is an internet connection and power. No servers to run and no software to maintain.
          </p>
        </div>
      </div>

      <!-- Card 6: Works with your equipment -->
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[32px] hover:border-[#94e760]/40 hover:-translate-y-1 hover:shadow-[0_14px_40px_rgba(0,0,0,0.3)] transition-all flex flex-col justify-between">
        <div>
          <div class="bg-[#94e760]/12 text-[#94e760] w-12 h-12 rounded-[11px] flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-[18.24px] font-bold text-[#eef3f7] mb-2.5">Works with your equipment</h3>
          <p class="text-[#9fb1c2] text-[15.36px] leading-[25px]">
            Keep your current fax machine or multifunction printer. FaxBridge simply bridges it to the modern internet.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
