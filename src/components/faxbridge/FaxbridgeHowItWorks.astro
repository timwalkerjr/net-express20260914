---
// FaxBridge How It Works Section
---

<section id="how-it-works" class="relative isolate py-[92px] bg-[#0c2136]/60 border-y border-white/[0.06]">
  <div class="max-w-[1180px] mx-auto px-6">

    <!-- Section Header -->
    <div class="max-w-[720px] text-left mb-[48px]">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-4 h-[2px] bg-[#94e760]"></span>
        <span class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase">
          How it works
        </span>
      </div>
      <h2 class="text-[36px] font-extrabold text-[#eef3f7] leading-[1.08] tracking-[-1.1px]">
        Faxing over the internet in three steps.
      </h2>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-[24px]">

      <!-- Step 1 -->
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[32px] hover:border-[#94e760]/40 transition-all">
        <div class="flex items-center gap-3 mb-4">
          <div class="bg-[#94e760]/15 text-[#94e760] w-10 h-10 rounded-[10px] flex items-center justify-center font-bold text-[18px]">
            1
          </div>
          <h3 class="text-[18.24px] font-bold text-[#eef3f7]">Plug it in</h3>
        </div>
        <p class="text-[#9fb1c2] text-[15.36px] leading-[25px]">
          Connect FaxBridge to your fax machine and your internet connection.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[32px] hover:border-[#94e760]/40 transition-all">
        <div class="flex items-center gap-3 mb-4">
          <div class="bg-[#94e760]/15 text-[#94e760] w-10 h-10 rounded-[10px] flex items-center justify-center font-bold text-[18px]">
            2
          </div>
          <h3 class="text-[18.24px] font-bold text-[#eef3f7]">We activate it</h3>
        </div>
        <p class="text-[#9fb1c2] text-[15.36px] leading-[25px]">
          Your device is provisioned on the Net Express network — no IT project required.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[32px] hover:border-[#94e760]/40 transition-all">
        <div class="flex items-center gap-3 mb-4">
          <div class="bg-[#94e760]/15 text-[#94e760] w-10 h-10 rounded-[10px] flex items-center justify-center font-bold text-[18px]">
            3
          </div>
          <h3 class="text-[18.24px] font-bold text-[#eef3f7]">Fax as usual</h3>
        </div>
        <p class="text-[#9fb1c2] text-[15.36px] leading-[25px]">
          Send from your fax machine like always; receive faxes by email and in the cloud.
        </p>
      </div>

    </div>
  </div>
</section>
