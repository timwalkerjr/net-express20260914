---
// Contact CTA Section
---

<section id="contact" class="relative isolate bg-[#0c2136]/50 border-t border-white/[0.06] py-[92px]" data-ps="src/components/home/ContactCta.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/home/ContactCta.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[48px] items-center" data-ps="src/components/home/ContactCta.astro:grid">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7" data-ps="src/components/home/ContactCta.astro:left-col">
        <div class="flex items-center gap-2 mb-3" data-ps="src/components/home/ContactCta.astro:eyebrow">
          <span class="w-4 h-[2px] bg-[#94e760]" data-ps="src/components/home/ContactCta.astro:tx0wsq"></span>
          <span class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase" data-ps="src/components/home/ContactCta.astro:tx0wsp">
            Get connected
          </span>
        </div>
        
        <h2 class="text-[36px] sm:text-[44px] font-extrabold text-[#eef3f7] leading-[1.08] tracking-[-1.1px] mb-4" data-ps="src/components/home/ContactCta.astro:h2">
          Let's simplify your business communications.
        </h2>
        
        <p class="text-[#9fb1c2] text-[17.28px] leading-[28.51px] mb-8 max-w-[560px]" data-ps="src/components/home/ContactCta.astro:p">
          Talk to a Michigan-based specialist. We'll design the right phone, internet, and IT setup for your business — and handle the switch.
        </p>

        <div class="flex flex-wrap gap-4" data-ps="src/components/home/ContactCta.astro:buttons">
          <a
            href="tel:+18553132300"
            class="bg-white text-[#0a1a2e] font-semibold text-[16px] px-[28px] py-[15px] rounded-[10px] hover:bg-[#eef3f7] transition-all no-underline"
            data-ps="src/components/home/ContactCta.astro:call-btn"
          >
            Call (855) 313-2300
          </a>
          <a
            href="mailto:support@gonetexpress.com"
            class="border border-white/20 text-[#e6ecf2] font-semibold text-[16px] px-[28px] py-[15px] rounded-[10px] hover:border-[#94e760] hover:text-white transition-all no-underline"
            data-ps="src/components/home/ContactCta.astro:email-btn"
          >
            Email us
          </a>
        </div>
      </div>

      <!-- Right Column: Contact Info Card -->
      <div class="lg:col-span-5" data-ps="src/components/home/ContactCta.astro:right-col">
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[18px] p-[28px] space-y-4" data-ps="src/components/home/ContactCta.astro:card">
          
          <!-- Row 1: Call -->
          <div class="flex items-center gap-4" data-ps="src/components/home/ContactCta.astro:row-1">
            <div class="bg-[#94e760]/12 text-[#94e760] p-3 rounded-[10px] shrink-0" data-ps="src/components/home/ContactCta.astro:t6222x">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div data-ps="src/components/home/ContactCta.astro:t6222y">
              <div class="text-[#9fb1c2] text-[11.5px] uppercase tracking-wider font-semibold" data-ps="src/components/home/ContactCta.astro:t6222z">Call us</div>
              <a href="tel:+18553132300" class="text-white font-semibold text-[16.8px] hover:text-[#94e760] transition-colors no-underline block" data-ps="src/components/home/ContactCta.astro:tahw90">
                (855) 313-2300
              </a>
            </div>
          </div>

          <!-- Row 2: Email -->
          <div class="flex items-center gap-4" data-ps="src/components/home/ContactCta.astro:row-2">
            <div class="bg-[#94e760]/12 text-[#94e760] p-3 rounded-[10px] shrink-0" data-ps="src/components/home/ContactCta.astro:t62230">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div data-ps="src/components/home/ContactCta.astro:t62231">
              <div class="text-[#9fb1c2] text-[11.5px] uppercase tracking-wider font-semibold" data-ps="src/components/home/ContactCta.astro:t62232">Email</div>
              <a href="mailto:support@gonetexpress.com" class="text-white font-semibold text-[16.8px] hover:text-[#94e760] transition-colors no-underline block" data-ps="src/components/home/ContactCta.astro:tahw8z">
                support@gonetexpress.com
              </a>
            </div>
          </div>

          <!-- Row 3: Visit -->
          <div class="flex items-center gap-4" data-ps="src/components/home/ContactCta.astro:row-3">
            <div class="bg-[#94e760]/12 text-[#94e760] p-3 rounded-[10px] shrink-0" data-ps="src/components/home/ContactCta.astro:t62233">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div data-ps="src/components/home/ContactCta.astro:t62234">
              <div class="text-[#9fb1c2] text-[11.5px] uppercase tracking-wider font-semibold" data-ps="src/components/home/ContactCta.astro:t62235">Visit</div>
              <div class="text-white font-semibold text-[16px]" data-ps="src/components/home/ContactCta.astro:t62236">
                6825 Dixie Hwy, Clarkston, MI 48346
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
